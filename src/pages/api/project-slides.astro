---
import ProjectSlide from "../../components/ProjectSlide.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { defaultLocale } from "../../i18n/locales"
import { pathFor } from "../../i18n/routes"
import { projectsFor } from "../../lib/content"

const lang = getLocale(Astro) ?? defaultLocale
const basePath = pathFor("projects", lang)
const projects = (await projectsFor(lang)).slice(3)
---

{projects.map((project, index) => (
  <ProjectSlide
    project={project.data}
    lang={lang}
    index={index + 4}
    href={`${basePath}#${project.data.id}`}
  />
))}

---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { useTranslations } from "../i18n/ui"
import { pathFor, type Locale } from "../i18n/routes"
const lang = getLocale(Astro) as Locale
const t = useTranslations(lang)
const impressumPath = pathFor("contact", lang)
---

<BaseLayout title={t("privacy.title")}>
  <h1 class="text-3xl font-bold mb-4">{t("privacy.title")}</h1>

  {lang === "de" ? (
    <>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Diese Website setzt keine Cookies zu Analyse-, Marketing- oder Statistikzwecken ein und
        verwendet keine Tracking-Tools. Verarbeitet werden nur Daten, die für den Betrieb der Seite
        und die Bearbeitung von Anfragen technisch notwendig sind.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Verantwortlicher</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Christoph Kröppl. Name, Anschrift und E-Mail-Adresse sind im{" "}
        <a class="link link-hover" href={impressumPath}>
          Impressum
        </a>{" "}
        angegeben.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Hosting</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Die Website läuft als Cloudflare Worker bei der Cloudflare, Inc., 101 Townsend St, San
        Francisco, CA 94107, USA. Beim Aufruf verarbeitet Cloudflare technisch notwendige
        Verbindungsdaten wie IP-Adresse, Zeitpunkt des Zugriffs, aufgerufene Ressource und
        User-Agent in Server-Logfiles. Rechtsgrundlage ist das berechtigte Interesse an einem
        sicheren und stabilen Betrieb gemäß Art. 6 Abs. 1 lit. f DSGVO. Mit Cloudflare besteht ein
        Auftragsverarbeitungsvertrag; die Übermittlung in die USA stützt sich auf das EU-US Data
        Privacy Framework.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Kontaktformular und Turnstile</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Um automatisierte Einsendungen zu verhindern, ist das Kontaktformular durch Cloudflare
        Turnstile geschützt. Turnstile verarbeitet dabei Client-Signale wie IP-Adresse,
        TLS-Fingerabdruck, User-Agent sowie den verwendeten Sitekey und die Herkunftsdomain.
        Turnstile setzt auf dieser Website keine Cookies; die Pre-Clearance-Funktion ist nicht
        aktiviert. Cloudflare handelt bei der Bot-Erkennung als Auftragsverarbeiter, bei der
        Verbesserung der eigenen Erkennungsverfahren als eigenständiger Verantwortlicher.
        Rechtsgrundlage ist das berechtigte Interesse an der Abwehr von Missbrauch gemäß Art. 6 Abs.
        1 lit. f DSGVO.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Übermittlung von Kontaktanfragen</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Die im Formular eingegebenen Angaben (Name, E-Mail-Adresse, Telefonnummer, Nachricht) werden
        über die Telegram Bot API an die Telegram Messenger Inc. übermittelt und dort gespeichert,
        damit die Anfrage bearbeitet werden kann. Rechtsgrundlage ist die Erfüllung der Anfrage
        gemäß Art. 6 Abs. 1 lit. b DSGVO sowie das berechtigte Interesse an einer verlässlichen
        Zustellung gemäß Art. 6 Abs. 1 lit. f DSGVO. Telegram betreibt für die Zustellung eigene
        Datenverarbeitung; es gilt zusätzlich die Datenschutzrichtlinie von Telegram. Anfragen
        werden gelöscht, sobald sie abschließend bearbeitet sind und keine gesetzlichen
        Aufbewahrungspflichten entgegenstehen.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Kontaktdaten auf dieser Website</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Anschrift, E-Mail-Adresse und Telefonnummer werden nicht mit dem Seitenquelltext
        ausgeliefert, sondern erst auf Klick vom Server abgerufen und als Grafik dargestellt. Dieser
        Abruf wird nicht gespeichert, enthält keine Cookies und bindet keine Dritten ein.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Deine Rechte</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Du hast das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung,
        Datenübertragbarkeit und Widerspruch gegen die Verarbeitung (Art. 15 bis 21 DSGVO). Zudem
        kannst du dich bei der Österreichischen Datenschutzbehörde beschweren:{" "}
        <a
          class="link link-hover"
          href="https://www.dsb.gv.at"
          target="_blank"
          rel="noopener noreferrer"
        >
          Barichgasse 40–42, 1030 Wien (dsb.gv.at)
        </a>
        .
      </p>

      <p class="mt-8 text-xs text-base-content/60">Stand: November 2026</p>
    </>
  ) : (
    <>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        This website sets no cookies for analytics, marketing or statistics and uses no tracking
        tools. Only data that is technically necessary to operate the site and answer enquiries is
        processed.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Controller</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        Christoph Kröppl. Name, postal address and email address are listed in the{" "}
        <a class="link link-hover" href={impressumPath}>
          legal notice
        </a>
        .
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Hosting</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        This website runs as a Cloudflare Worker at Cloudflare, Inc., 101 Townsend St, San
        Francisco, CA 94107, USA. When the site is accessed, Cloudflare processes technically
        necessary connection data such as IP address, time of access, requested resource and user
        agent in server logs. The legal basis is the legitimate interest in secure and stable
        operation under Art. 6(1)(f) GDPR. A data processing agreement is in place with Cloudflare;
        transfers to the United States rely on the EU-US Data Privacy Framework.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Contact form and Turnstile</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        To prevent automated submissions, the contact form is protected by Cloudflare Turnstile.
        Turnstile processes client signals such as IP address, TLS fingerprint, user agent, and the
        sitekey and origin used. Turnstile sets no cookies on this website; pre-clearance is not
        enabled. Cloudflare acts as a processor for bot detection and as an independent controller
        when improving its own detection methods. The legal basis is the legitimate interest in
        preventing abuse under Art. 6(1)(f) GDPR.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Delivery of contact requests</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        The details entered in the form (name, email address, phone number, message) are transmitted
        via the Telegram Bot API to Telegram Messenger Inc. and stored there so the enquiry can be
        handled. The legal basis is the performance of your request under Art. 6(1)(b) GDPR and the
        legitimate interest in reliable delivery under Art. 6(1)(f) GDPR. Telegram carries out its
        own data processing for delivery; Telegram's privacy policy applies additionally. Enquiries
        are deleted once they have been fully handled and no statutory retention obligations apply.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Contact details on this website</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        The postal address, email address and phone number are not shipped with the page source.
        They are requested from the server only after a click and rendered as graphics. That request
        is not stored, sets no cookies and involves no third parties.
      </p>

      <h2 class="text-lg font-semibold mt-8 mb-2">Your rights</h2>
      <p class="mb-6 leading-relaxed text-sm text-base-content/80">
        You have the right to access, rectification, erasure, restriction of processing, data
        portability and objection to processing (Art. 15 to 21 GDPR). You may also lodge a complaint
        with the Austrian Data Protection Authority:{" "}
        <a
          class="link link-hover"
          href="https://www.dsb.gv.at"
          target="_blank"
          rel="noopener noreferrer"
        >
          Barichgasse 40–42, 1030 Vienna (dsb.gv.at)
        </a>
        .
      </p>

      <p class="mt-8 text-xs text-base-content/60">Last updated: November 2026</p>
    </>
  )}
</BaseLayout>

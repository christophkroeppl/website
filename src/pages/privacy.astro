---
import { getEntry, render } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getLocale } from "virtual:astro-localized-routes"

const lang = getLocale(Astro)
const entry = await getEntry("privacy", lang)
if (!entry) throw new Error(`Missing privacy content for ${lang}`)
const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title}>
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-bold mb-4">{entry.data.title}</h1>
    <div class="legal">
      <Content />
    </div>
    <p class="mt-8 text-xs text-base-content/60">{entry.data.updated}</p>
  </div>
</BaseLayout>

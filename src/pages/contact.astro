---
import BaseLayout from "../layouts/BaseLayout.astro"
import Reveal from "../components/Reveal.astro"
import ContactModal from "../components/ContactModal.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { useTranslations } from "../i18n/ui"

const lang = getLocale(Astro)
const t = useTranslations(lang)
const name = import.meta.env.PUBLIC_CONTACT_NAME
---

<BaseLayout title={t("impressum.title")}>
  <div class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="eyebrow">{t("nav.impressum")}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em]">{t("impressum.title")}</h1>
    <span class="title-rule" aria-hidden="true"></span>
    <p class="mt-8 mb-4 leading-relaxed text-sm text-base-content/80">{t("impressum.notice")}</p>
    <p class="mb-6 text-xs text-base-content/65">
      <a
        class="link link-hover text-accent"
        href="https://www.ris.bka.gv.at/NormDokument.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10000719&Paragraf=25"
        target="_blank"
        rel="noopener noreferrer"
      >
        § 25 Mediengesetz (RIS)
      </a>
    </p>
    <div class="mb-6 leading-relaxed">
      {name && (
        <div class="mb-4">
          <h2 class="text-lg font-semibold">{t("impressum.owner")}</h2>
          <p class="mt-1">{name}</p>
        </div>
      )}
      <Reveal id="contact" lang={lang} />
    </div>

    <ContactModal lang={lang} />
  </div>
</BaseLayout>

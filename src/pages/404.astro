---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { useTranslations } from "../i18n/ui"
import { pathFor } from "../i18n/routes"

export const prerender = false

const lang = getLocale(Astro)
const t = useTranslations(lang)
---

<BaseLayout title={t("notFound.title")} description={t("notFound.body")} noindex>
  <div class="mx-auto flex w-full max-w-3xl flex-col items-start px-4 py-20 sm:px-6 sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">
      {t("notFound.title")}
    </h1>
    <span class="title-rule" aria-hidden="true"></span>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-base-content/60">{t("notFound.body")}</p>
    <a class="btn btn-ghost mt-8" href={pathFor("home", lang)}>
      {t("notFound.back")}
    </a>
  </div>
</BaseLayout>

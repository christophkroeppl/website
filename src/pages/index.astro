---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { useTranslations } from "../i18n/ui"
import type { Locale } from "../i18n/routes"
const lang = getLocale(Astro) as Locale
const t = useTranslations(lang)
---

<BaseLayout title={t("home.title")}>
  <h1 class="text-3xl font-bold mb-4">{t("home.title")}</h1>
  <p class="leading-relaxed">{t("home.experience")}</p>
  <p class="mt-4 leading-relaxed">{t("home.approach")}</p>
</BaseLayout>

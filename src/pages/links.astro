---
import LinksLayout from "../layouts/LinksLayout.astro"
import ContactModal from "../components/ContactModal.astro"
import LinkButton from "../components/LinkButton.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { person } from "../content/site"
import { pathFor } from "../i18n/routes"
import { useTranslations } from "../i18n/ui"
import { linkHref } from "../links/urls"
import { drawerLinks } from "../links/drawer"
import { groupLinks } from "../links/group"
import { linksFor } from "../lib/content"
import { links } from "../generated/links"

const lang = getLocale(Astro)
const t = useTranslations(lang)
const entry = await linksFor(lang)
const description = entry.data.description
const tagline = entry.data.lines
const website = linkHref("website")
const privacyHref = website ? new URL(pathFor("privacy", lang), website).href : undefined
const { visible, more } = drawerLinks(links)

const mailPath =
  "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
---

<LinksLayout name={person.name} description={description} tagline={tagline} lang={lang}>
  {groupLinks(visible).map((group) => {
    const first = group[0]
    if (!first) return null
    return group.length > 1 ? (
      <div class="grid grid-cols-2 gap-3">
        {group.map((link) => (
          <LinkButton link={link} />
        ))}
      </div>
    ) : (
      <LinkButton link={first} />
    )
  })}

  <button
    type="button"
    data-contact-open
    class="btn btn-primary btn-lg btn-block justify-start gap-3 font-normal"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="currentColor"
      class="shrink-0"
      aria-hidden="true"
    >
      <path d={mailPath} />
    </svg>
    <span class="truncate">{t("links.inquiries")}</span>
  </button>

  <button
    type="button"
    id="links-drawer-toggle"
    aria-expanded="false"
    aria-controls="links-drawer"
    class="btn btn-accent btn-soft btn-lg btn-block justify-center gap-2 font-normal"
  >
    <span>{t("links.more")}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-4 w-4 shrink-0 transition-transform"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <div id="links-drawer" hidden class="w-full space-y-3"></div>

  <template id="links-drawer-content">
    {groupLinks(more).map((group) => {
      const first = group[0]
      if (!first) return null
      return group.length > 1 ? (
        <div class="grid grid-cols-2 gap-3">
          {group.map((link) => (
            <LinkButton link={link} />
          ))}
        </div>
      ) : (
        <LinkButton link={first} />
      )
    })}
  </template>

  <ContactModal lang={lang} trigger={false} {...(privacyHref ? { privacyHref } : {})} />
</LinksLayout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#links-drawer-toggle")
  const drawer = document.querySelector<HTMLElement>("#links-drawer")
  const template = document.querySelector<HTMLTemplateElement>("#links-drawer-content")

  toggle?.addEventListener("click", () => {
    if (!drawer || !template) return
    const expanded = toggle.getAttribute("aria-expanded") === "true"
    if (!expanded && drawer.childElementCount === 0) {
      drawer.append(template.content.cloneNode(true))
    }
    toggle.setAttribute("aria-expanded", String(!expanded))
    toggle.querySelector("svg")?.classList.toggle("rotate-180", !expanded)
    drawer.hidden = expanded
  })
</script>

---
import LinksLayout from "../layouts/LinksLayout.astro"
import ContactModal from "../components/ContactModal.astro"
import ContactTrigger from "../components/ContactTrigger.astro"
import LinkGroups from "../components/LinkGroups.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { person } from "../content/site"
import { pathFor } from "../i18n/routes"
import { useTranslations } from "../i18n/ui"
import { firstLinkHref } from "../links/urls"
import { drawerLinks } from "../links/drawer"
import { linksFor } from "../lib/content"
import { links } from "../generated/links"

const lang = getLocale(Astro)
const t = useTranslations(lang)
const entry = await linksFor(lang)
const description = entry.data.description
const tagline = entry.data.lines
const website = firstLinkHref("website")
const privacyHref = website ? new URL(pathFor("privacy", lang), website).href : undefined
const { visible, more } = drawerLinks(links)

const mailPath =
  "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
---

<LinksLayout name={person.name} description={description} tagline={tagline} lang={lang}>
  <LinkGroups links={visible} />

  <ContactModal lang={lang} {...(privacyHref ? { privacyHref } : {})}>
    <ContactTrigger
      label={t("links.inquiries")}
      class="btn btn-primary btn-lg btn-block justify-start gap-3 font-normal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        class="shrink-0"
        aria-hidden="true"
      >
        <path d={mailPath} />
      </svg>
    </ContactTrigger>
  </ContactModal>

  <details class="group w-full">
    <summary class="btn btn-accent btn-soft btn-lg btn-block list-none justify-center gap-2 font-normal [&::-webkit-details-marker]:hidden">
      <span>{t("links.more")}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <div class="mt-3 w-full space-y-3">
      <LinkGroups links={more} />
    </div>
  </details>
</LinksLayout>

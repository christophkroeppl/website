---
import LinksLayout from "../layouts/LinksLayout.astro"
import ContactModal from "../components/ContactModal.astro"
import LinkButton from "../components/LinkButton.astro"
import { person } from "../content/site"
import { pathFor, type Locale } from "../i18n/routes"
import { linkHref } from "../links/urls"
import { groupLinks } from "../links/group"
import { contactEmail, links, tagline } from "../generated/links"

const lang = "en" satisfies Locale
const website = linkHref("website")
const privacyHref = website ? new URL(pathFor("privacy", lang), website).href : undefined

const mailPath =
  "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
---

<LinksLayout name={person.name} tagline={tagline}>
  {groupLinks(links).map((group) => {
    const first = group[0]
    if (!first) return null
    return group.length > 1 ? (
      <div class="grid grid-cols-2 gap-3">
        {group.map((link) => (
          <LinkButton link={link} />
        ))}
      </div>
    ) : (
      <LinkButton link={first} />
    )
  })}

  {contactEmail && (
    <a
      href={`mailto:${contactEmail}`}
      class="btn btn-outline btn-lg btn-block justify-start gap-3 font-normal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        class="shrink-0"
        aria-hidden="true"
      >
        <path d={mailPath} />
      </svg>
      <span class="truncate">Email</span>
    </a>
  )}

  <button
    type="button"
    data-contact-open
    class="btn btn-primary btn-lg btn-block justify-start gap-3 font-normal"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="currentColor"
      class="shrink-0"
      aria-hidden="true"
    >
      <path d={mailPath} />
    </svg>
    <span class="truncate">Inquiries</span>
  </button>

  <ContactModal lang={lang} trigger={false} {...(privacyHref ? { privacyHref } : {})} />
</LinksLayout>

---
import "../styles/global.css"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { getLocale } from "virtual:astro-localized-routes"
import { localeMeta } from "../i18n/locales"
import { activePage } from "../i18n/routes"
import { useTranslations } from "../i18n/ui"
import { og, person } from "../content/site"
import { cvFor, descriptionFor, rolesFor, skillsFor } from "../lib/content"
import { canonicalFor } from "../lib/canonical"
import { formatPageTitle, inLanguage, ogLocale, otherLocale, siteUrl } from "../lib/seo"
import { markdownPath } from "../lib/urls"
import { pageMeta } from "../lib/page-meta"
import { pageAlternates } from "../lib/alternates"
import {
  breadcrumbNode,
  graph,
  personNode,
  webPageNode,
  websiteNode,
  type Node,
} from "../lib/schema"

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  schema?: Node[]
}

const { title = person.name, description, image, noindex = false, schema = [] } = Astro.props
const lang = getLocale(Astro)
const t = useTranslations(lang)
const page = activePage(Astro.url.pathname)
const meta = page ? pageMeta[page] : undefined
const site = Astro.site ?? new URL(siteUrl)
const canonical = page ? canonicalFor(page, lang) : new URL(Astro.url.pathname, site).href
const metaDescription = description
const pageTitle = formatPageTitle(title)
const brandImage = lang === "en" ? "/og-en.png" : "/og.png"
const ogImage = new URL(image ?? brandImage, site).href
const ogImageAlt = image ? pageTitle : `${person.name} — ${og.subtitle[lang]}`
const alternates =
  noindex || !page
    ? []
    : pageAlternates(page).map((alternate) => ({
        hreflang: alternate.hreflang,
        href: new URL(alternate.path, site).href,
      }))
const xDefault = alternates.find((alternate) => alternate.hreflang === "x-default")?.href
const [skills, cv, roles, homeDescription] = await Promise.all([
  skillsFor(lang),
  cvFor(lang),
  rolesFor(lang),
  descriptionFor(lang, "home"),
])
const knowsAbout = skills.map((group) => group.data.label)
const knowsLanguage = cv.data.languages.map((language) => language.code)
const employers = [...new Set(roles.map((role) => role.data.org))]
const structuredData = noindex
  ? undefined
  : graph([
      personNode(lang, {
        knowsAbout,
        knowsLanguage,
        description: homeDescription,
        employers,
        ...(meta?.personMainEntityOfPage ? { mainEntityOfPage: `${canonical}#webpage` } : {}),
      }),
      websiteNode(),
      ...(page
        ? [
            webPageNode({
              lang,
              page,
              title: pageTitle,
              ...(metaDescription ? { description: metaDescription } : {}),
              url: canonical,
            }),
            breadcrumbNode({ lang, page, title, url: canonical }),
          ]
        : []),
      ...schema,
    ])
const markdownAlternate =
  !noindex && page ? new URL(markdownPath(lang, page), site).href : undefined
const llmsPath = localeMeta[lang].llmsPath
const ogLocaleAlternate = ogLocale(otherLocale(lang))
const nameParts = page === "home" ? person.name.split(" ") : []
const firstName = nameParts[0] ?? ""
const lastName = nameParts.slice(1).join(" ")
---

<!doctype html>
<html lang={inLanguage(lang)} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta property="og:type" content={meta?.ogType ?? "website"} />
    <meta property="og:title" content={pageTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {meta?.profileName && <meta property="profile:first_name" content={firstName} />}
    {meta?.profileName && <meta property="profile:last_name" content={lastName} />}
    {!noindex && alternates.length > 0 && (
      <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
      />
    )}
    {!noindex && (
      <link rel="sitemap" type="application/xml" href={new URL("/sitemap.xml", site).href} />
    )}
    {!noindex && <link rel="describedby" type="text/plain" href={new URL(llmsPath, site).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body class="flex min-h-dvh flex-col bg-base-100 text-base-content antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-base-content focus:px-4 focus:py-2 focus:text-sm focus:text-base-100"
    >
      {t("a11y.skip")}
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

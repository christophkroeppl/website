---
import "../styles/global.css"
import { getAlternates, getLocale } from "virtual:astro-localized-routes"
import { pathFor, type Locale } from "../i18n/routes"
import { useTranslations } from "../i18n/ui"
import { Image } from "astro:assets"
import ck from "../assets/ck.webp"
const lang = getLocale(Astro) as Locale
const t = useTranslations(lang)
const homePath = pathFor("home", lang)
const contactPath = pathFor("contact", lang)
const privacyPath = pathFor("privacy", lang)
const otherLang = lang === "de" ? "en" : "de"
const otherPath =
  getAlternates(Astro).find((alternate) => alternate.locale === otherLang)?.path ??
  pathFor("home", otherLang)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title ?? "Website"}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="bg-base-200">
      <div class="navbar mx-auto w-full max-w-3xl px-4">
        <div class="navbar-start">
          <a href={homePath} class="btn btn-ghost btn-circle btn-lg" aria-label={t("home.title")}>
            <Image src={ck} alt="" class="size-10 rounded-full object-cover" />
          </a>
        </div>
        <nav class="navbar-end gap-1">
          <a
            href="https://github.com/christophkroeppl"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="btn btn-ghost btn-lg text-base-content/60"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/christoph-kroeppl/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="btn btn-ghost btn-lg text-base-content/60"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <button
            id="lang-toggle"
            class="btn btn-ghost btn-lg group w-17"
            data-target={otherPath}
            data-lang={otherLang}
            aria-label={t("nav.switchLang")}
          >
            <span class="group-hover:hidden">{lang.toUpperCase()}</span>
            <span class="hidden group-hover:inline">{otherLang.toUpperCase()}</span>
          </button>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
      <slot />
    </main>
    <footer class="bg-base-200">
      <div class="footer sm:footer-horizontal mx-auto w-full max-w-3xl place-items-center gap-4 px-4 py-4 sm:justify-between">
        <nav class="flex gap-4">
          <a class="link link-hover" href={contactPath}>
            {t("nav.impressum")}
          </a>
          <a class="link link-hover" href={privacyPath}>
            {t("nav.privacy")}
          </a>
        </nav>
        <p>© {new Date().getFullYear()} Christoph Kröppl</p>
      </div>
    </footer>
    <script is:inline>
      ;(function () {
        const btn = document.getElementById("lang-toggle")
        btn?.addEventListener("click", function () {
          const target = btn.getAttribute("data-target")
          const nextLang = btn.getAttribute("data-lang")
          if (nextLang) localStorage.setItem("lang", nextLang)
          if (target) location.href = target
        })
        const stored = localStorage.getItem("lang")
        const isEn = location.pathname.startsWith("/en")
        const current = isEn ? "en" : "de"
        let targetLang = stored
        if (!targetLang) {
          targetLang = (navigator.language || "").toLowerCase().startsWith("en") ? "en" : "de"
        }
        if (targetLang && targetLang !== current) {
          localStorage.setItem("lang", targetLang)
          if (btn) {
            const t = btn.getAttribute("data-target")
            if (t) location.href = t
          }
        }
      })()
    </script>
  </body>
</html>

---
import "../styles/global.css"
import { Image } from "astro:assets"
import bullet from "../assets/bullet.webp"

type Props = {
  name: string
  description: string
  tagline?: string
}

const { name, description, tagline } = Astro.props
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body class="min-h-dvh bg-base-100 text-base-content antialiased">
    <main class="mx-auto flex min-h-dvh w-full max-w-sm flex-col items-center px-4 py-12">
      <div class="avatar">
        <div class="w-28 rounded-full ring-2 ring-primary/40 ring-offset-2 ring-offset-base-100">
          <Image
            src={bullet}
            alt={name}
            width={224}
            height={224}
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <h1 class="mt-4 text-center text-2xl font-semibold tracking-tight">{name}</h1>
      {tagline && (
        <div class="mt-2 space-y-1">
          {tagline
            .split("\n")
            .map((line) => line.trim())
            .filter(Boolean)
            .map((line) => (
              <p class="text-center text-sm text-base-content/70">{line}</p>
            ))}
        </div>
      )}

      <div class="mt-8 flex w-full flex-1 flex-col gap-3">
        <slot />
      </div>

      <p class="mt-10 text-xs text-base-content/65">
        © {year} {name}
      </p>
    </main>
  </body>
</html>

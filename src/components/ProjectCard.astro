---
import type { ProjectData } from "../content.config"
import type { Locale } from "../i18n/locales"
import { useTranslations } from "../i18n/ui"

interface Props {
  project: ProjectData
  lang: Locale
  index: number
  href: string
}

const { project, lang, index, href } = Astro.props
const t = useTranslations(lang)
---

<article class="flex h-full flex-col section-rule pt-5">
  <div class="flex items-baseline justify-between gap-4">
    <span class="font-mono text-xs font-medium text-accent">{String(index).padStart(2, "0")}</span>
    <span class="badge badge-soft badge-neutral">{project.status}</span>
  </div>
  <h3 class="mt-3 text-xl font-semibold tracking-[-0.015em]">
    <a class="transition-colors hover:text-primary" href={href}>
      {project.name}
    </a>
  </h3>
  <p class="mt-1 text-sm text-base-content/65">{project.tagline}</p>
  <p class="mt-4 text-sm leading-relaxed text-base-content/70">{project.summary}</p>
  <p class="mt-5 font-mono text-[0.62rem] uppercase leading-relaxed tracking-[0.12em] text-base-content/65">
    {project.stack.join(" · ")}
  </p>
  <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-5 text-sm">
    <a class="link-quiet" href={href}>
      {t("projects.single")}
    </a>
    {project.links.map((link) => (
      <a class="link-quiet" href={link.href} target="_blank" rel="noopener noreferrer">
        {link.label} ↗
      </a>
    ))}
  </div>
</article>

---
import { getAlternates, getLocale } from "virtual:astro-localized-routes"
import { languages } from "../i18n/locales"
import { inLanguage } from "../lib/seo"

const locale = getLocale(Astro)
const alternates = getAlternates(Astro).filter((alternate) => alternate.locale !== locale)
const alternate = alternates[0]

const linkClass =
  "grid h-9 min-w-9 place-items-center rounded-full px-2 text-sm font-semibold text-base-content/65 transition-colors hover:bg-accent/10 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
---

{alternate && alternates.length === 1 ? (
  <a
    href={alternate.path}
    hreflang={inLanguage(alternate.locale)}
    lang={alternate.locale}
    title={languages[alternate.locale]}
    aria-label={`${alternate.locale.toUpperCase()} — ${languages[alternate.locale]}`}
    data-astro-prefetch="false"
    class:list={["group ml-1", linkClass]}
  >
    <span class="group-hover:hidden group-focus-visible:hidden">{locale.toUpperCase()}</span>
    <span class="hidden group-hover:inline group-focus-visible:inline" aria-hidden="true">
      {alternate.locale.toUpperCase()}
    </span>
  </a>
) : null}

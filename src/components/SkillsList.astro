---
import { pick } from "../content/types"
import type { SkillGroup } from "../content/skills"
import type { Locale } from "../i18n/locales"

interface Props {
  groups: SkillGroup[]
  lang: Locale
  compact?: boolean
}

const { groups, lang, compact = false } = Astro.props
const visible = compact ? groups.filter((group) => group.id !== "bitcoin") : groups

const tones = [
  "border-series-1/25 bg-series-1/10 text-series-1",
  "border-series-4/25 bg-series-4/10 text-series-4",
  "border-series-3/25 bg-series-3/10 text-series-3",
  "border-series-6/25 bg-series-6/10 text-series-6",
  "border-series-5/25 bg-series-5/10 text-series-5",
  "border-series-2/25 bg-series-2/10 text-series-2",
]

const toneFor = (index: number) => tones[index % tones.length]
---

<div class="grid gap-4 sm:grid-cols-2">
  {visible.map((group, index) => (
    <div class:list={["rounded-box border p-4", toneFor(index)]}>
      <h3 class="font-mono text-[0.65rem] uppercase tracking-[0.16em]">
        {pick(lang, group.label)}
      </h3>
      <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-base-content/70">
        {group.items.map((item) => (
          <li>{pick(lang, item)}</li>
        ))}
      </ul>
    </div>
  ))}
</div>

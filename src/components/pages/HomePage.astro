---
import Section from "../Section.astro"
import ProofGrid from "../ProofGrid.astro"
import ProjectCarousel from "../ProjectCarousel.astro"
import Timeline from "../Timeline.astro"
import SkillsList from "../SkillsList.astro"
import ContactCta from "../ContactCta.astro"
import ContactModal from "../ContactModal.astro"
import { about, homeSections } from "../../content/site"
import { pick } from "../../content/types"
import {
  contactFor,
  homeFor,
  projectsFor,
  renderEntry,
  rolesFor,
  skillsFor,
} from "../../lib/content"
import { pathFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const projects = await projectsFor(lang)
const roles = await rolesFor(lang)
const skills = await skillsFor(lang)
const homeEntry = await homeFor(lang)
const home = homeEntry.data
const contact = (await contactFor(lang)).data
const { Content: AboutParagraphs } = await renderEntry(homeEntry)
const latestRole = roles[0]
if (!latestRole) throw new Error("No roles to render")
const latestRoleTitle = `${latestRole.data.title} · ${latestRole.data.org}`
---

<section>
  <div class="mx-auto w-full max-w-5xl px-4 pb-14 pt-12 sm:px-6 sm:pb-20 sm:pt-20">
    <p class="eyebrow">{home.eyebrow}</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-balance sm:text-7xl">
      {home.title}
    </h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="max-w-2xl space-y-4">
        <p class="text-lg leading-relaxed text-base-content/75">{home.lead}</p>
        <p class="text-base leading-relaxed text-base-content/65" set:html={home.secondary} />
      </div>
      <div class="flex flex-wrap items-center gap-3 lg:justify-end">
        <button type="button" data-contact-open class="btn btn-primary">
          {contact.cta}
        </button>
        <a class="btn btn-outline btn-accent" href={pathFor("projects", lang)}>
          {home.projectsCta}
        </a>
      </div>
    </div>

    <div class="mt-12 sm:mt-16">
      <ProofGrid items={home.proof} />
    </div>
  </div>
</section>

<Section
  id="work"
  eyebrow={pick(lang, homeSections.workEyebrow)}
  title={home.workTitle}
  intro={home.workIntro}
>
  <a slot="action" class="btn btn-outline btn-accent shrink-0" href={pathFor("projects", lang)}>
    {home.projectsCta}
  </a>
  <ProjectCarousel
    projects={projects}
    lang={lang}
    basePath={pathFor("projects", lang)}
    label={home.workTitle}
  />
</Section>

<Section
  id="experience"
  eyebrow={pick(lang, homeSections.experienceEyebrow)}
  title={latestRoleTitle}
>
  <a slot="action" class="btn btn-outline btn-accent shrink-0" href={pathFor("cv", lang)}>
    {home.cvCta}
  </a>
  <Timeline roles={[latestRole]} compact />
</Section>

<Section
  id="skills"
  eyebrow={pick(lang, homeSections.skillsEyebrow)}
  title={pick(lang, homeSections.skillsTitle)}
  intro={pick(lang, homeSections.skillsIntro)}
  tone="primary"
>
  <SkillsList groups={skills.map((group) => group.data)} />
</Section>

<Section id="about" eyebrow={pick(lang, about.eyebrow)} title={home.aboutTitle}>
  <div class="grid gap-10 md:grid-cols-[1fr_16rem]">
    <div class="max-w-2xl space-y-5 text-base leading-relaxed text-base-content/70">
      <AboutParagraphs />
    </div>
    <div class="flex h-full flex-col justify-between gap-6 rounded-r-box border-l-2 border-primary bg-primary/5 p-5">
      <blockquote class="text-lg leading-relaxed text-base-content/75">
        {home.aboutQuote}
      </blockquote>
      <a
        class="btn btn-soft btn-primary self-end"
        href="https://grugbrain.dev/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {home.philosophyCta} ↗
      </a>
    </div>
  </div>
</Section>

<ContactCta />

<ContactModal lang={lang} trigger={false} />

---
import Section from "../Section.astro"
import ProofGrid from "../ProofGrid.astro"
import ContactCta from "../ContactCta.astro"
import ContactModal from "../ContactModal.astro"
import { about, contact, home as homeContent } from "../../content/site"
import { linkHref } from "../../links/urls"
import { pick } from "../../content/types"
import { pathFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const github = linkHref("github")
---

<section class="border-b border-base-300/60">
  <div class="mx-auto w-full max-w-5xl px-4 pb-14 pt-12 sm:px-6 sm:pb-20 sm:pt-20">
    <p class="eyebrow">{pick(lang, homeContent.eyebrow)}</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-balance sm:text-7xl">
      {pick(lang, homeContent.title)}
    </h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="max-w-2xl space-y-4">
        <p class="text-lg leading-relaxed text-base-content/75">{pick(lang, homeContent.lead)}</p>
        <p
          class="text-base leading-relaxed text-base-content/55"
          set:html={pick(lang, homeContent.secondary)}
        />
      </div>
      <div class="flex flex-wrap items-center gap-3 lg:justify-end">
        <button type="button" data-contact-open class="btn btn-primary">
          {pick(lang, contact.cta)}
        </button>
        {github && (
          <a class="btn btn-ghost" href={github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        )}
      </div>
    </div>

    <div class="mt-12 sm:mt-16">
      <ProofGrid lang={lang} />
    </div>
  </div>
</section>

<Section id="about" eyebrow={pick(lang, about.eyebrow)} title={pick(lang, about.title)}>
  <div class="grid gap-10 md:grid-cols-[1fr_16rem]">
    <div class="max-w-2xl space-y-5 text-base leading-relaxed text-base-content/70">
      {about.paragraphs.map((paragraph) => (
        <p set:html={pick(lang, paragraph)} />
      ))}
    </div>
    <div class="flex h-full flex-col justify-between gap-6 border-l-2 border-primary pl-5">
      <blockquote class="text-lg leading-relaxed text-base-content/75">
        {pick(lang, about.quote)}
      </blockquote>
      <a class="btn btn-ghost btn-sm self-end" href={pathFor("cv", lang)}>
        {pick(lang, homeContent.cvCta)}
      </a>
    </div>
  </div>
</Section>

<ContactCta />

<ContactModal lang={lang} trigger={false} />

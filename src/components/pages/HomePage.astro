---
import Section from "../Section.astro"
import ProofGrid from "../ProofGrid.astro"
import ProjectCarousel from "../ProjectCarousel.astro"
import Timeline from "../Timeline.astro"
import SkillsList from "../SkillsList.astro"
import ContactCta from "../ContactCta.astro"
import ContactTrigger from "../ContactTrigger.astro"
import { homeComposition } from "../../lib/home-composition"
import { pathFor, type Locale } from "../../i18n/routes"
import { useTranslations } from "../../i18n/ui"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const {
  home,
  projects,
  skills,
  contact,
  latest,
  titles,
  Content: AboutParagraphs,
} = await homeComposition(lang)
---

<section>
  <div class="page-container pb-14 pt-12 sm:pb-20 sm:pt-20">
    <p class="eyebrow">{home.eyebrow}</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-balance sm:text-7xl">
      {home.title}
    </h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="max-w-2xl space-y-4">
        <p class="text-lg leading-relaxed text-base-content/75">{home.lead}</p>
        <p class="text-base leading-relaxed text-base-content/65" set:html={home.secondary} />
      </div>
      <div class="flex flex-wrap items-center gap-3 lg:justify-end">
        <ContactTrigger label={contact.cta} />
        <a class="btn btn-outline btn-accent" href={pathFor("projects", lang)}>
          {home.projectsCta}
        </a>
      </div>
    </div>

    <div class="mt-12 sm:mt-16">
      <ProofGrid items={home.proof} />
    </div>
  </div>
</section>

<Section id="work" eyebrow={titles.eyebrowWork} title={titles.work} intro={home.workIntro}>
  <div slot="action" class="grid w-full grid-cols-[1fr_auto_1fr] items-center sm:block">
    <button
      type="button"
      class="btn btn-sm btn-circle btn-outline btn-accent justify-self-center sm:hidden"
      data-carousel-prev
      aria-label={t("projects.previous")}
      disabled
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 19-7-7 7-7" />
      </svg>
    </button>
    <a class="btn btn-outline btn-accent shrink-0" href={pathFor("projects", lang)}>
      {home.projectsCta}
    </a>
    <button
      type="button"
      class="btn btn-sm btn-circle btn-outline btn-accent justify-self-center sm:hidden"
      data-carousel-next
      aria-label={t("projects.next")}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 5 7 7-7 7" />
      </svg>
    </button>
  </div>
  <ProjectCarousel
    projects={projects}
    lang={lang}
    basePath={pathFor("projects", lang)}
    label={titles.work}
  />
</Section>

<Section id="experience" eyebrow={titles.eyebrowExperience} title={titles.experience}>
  <a slot="action" class="btn btn-outline btn-accent shrink-0" href={pathFor("cv", lang)}>
    {home.cvCta}
  </a>
  <Timeline roles={[latest]} compact />
</Section>

<Section
  id="skills"
  eyebrow={titles.skillsEyebrow}
  title={titles.skills}
  intro={titles.eyebrowSkills}
  tone="primary"
>
  <SkillsList groups={skills.map((group) => group.data)} />
</Section>

<Section id="about" eyebrow={titles.eyebrowAbout} title={titles.about}>
  <div class="grid gap-10 md:grid-cols-[1fr_16rem]">
    <div class="max-w-2xl space-y-5 text-base leading-relaxed text-base-content/70">
      <AboutParagraphs />
    </div>
    <div class="flex h-full flex-col justify-between gap-6 rounded-r-box border-l-2 border-primary bg-primary/5 p-5">
      <blockquote class="text-lg leading-relaxed text-base-content/75">
        {home.aboutQuote}
      </blockquote>
      <a
        class="btn btn-soft btn-primary self-end"
        href="https://grugbrain.dev/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {home.philosophyCta} ↗
      </a>
    </div>
  </div>
</Section>

<ContactCta />

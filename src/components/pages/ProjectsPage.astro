---
import PageHeader from "../PageHeader.astro"
import CaseStudy from "../CaseStudy.astro"
import ContactCta from "../ContactCta.astro"
import { projectsFor, renderEntry } from "../../lib/content"
import { type Locale } from "../../i18n/routes"
import { useTranslations } from "../../i18n/ui"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const entries = await projectsFor(lang)
const projects = await Promise.all(
  entries.map(async (entry) => ({ entry, ...(await renderEntry(entry)) })),
)
---

<PageHeader
  eyebrow={t("projects.eyebrow")}
  title={t("projects.title")}
  lead={t("projects.intro")}
/>

<div class="page-container section-rule py-14 sm:py-20">
  {projects.map(({ entry, Content }, index) => (
    <CaseStudy project={entry.data} index={index + 1}>
      <Content />
    </CaseStudy>
  ))}
</div>

<ContactCta />

---
interface Props {
  eyebrow: string
  title: string
  lead?: string
}

const { eyebrow, title, lead } = Astro.props
---

<header class="bg-primary/5">
  <div class="page-container py-14 sm:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
      {title}
    </h1>
    <span class="title-rule" aria-hidden="true"></span>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/65">{lead}</p>}
    <slot />
  </div>
</header>

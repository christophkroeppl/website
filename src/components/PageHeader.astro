---
interface Props {
  eyebrow: string
  title: string
  lead?: string
}

const { eyebrow, title, lead } = Astro.props
---

<header class="border-b border-base-300/60 bg-base-200/30">
  <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
      {title}
    </h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-base-content/65">{lead}</p>}
    <slot />
  </div>
</header>

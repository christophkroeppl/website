---
import { links } from "../generated/links"
import { drawerLinks } from "../links/drawer"
import { externalAttrs } from "../links/external"
import LinkIcon from "./LinkIcon.astro"

interface Props {
  label: string
  moreLabel: string
}

const { label, moreLabel } = Astro.props
const { visible, more } = drawerLinks(links.filter((link) => link.slug !== "website"))

const linkGlyph = [
  "M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z",
  "M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243L6.586 4.672z",
]
const moreDots = [5, 12, 19]
---

<nav class="hidden items-center gap-1 lg:flex" aria-label={label}>
  {visible.map((link) => (
    <a
      href={link.href}
      aria-label={link.label}
      title={link.label}
      class="icon-link text-base-content/55"
      {...externalAttrs(link.href)}
    >
      <LinkIcon link={link} size={17} />
    </a>
  ))}
  {more.length > 0 && (
    <details class="relative">
      <summary
        aria-label={moreLabel}
        title={moreLabel}
        class="icon-link cursor-pointer text-base-content/55 list-none [&::-webkit-details-marker]:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="currentColor"
          aria-hidden="true"
        >
          {moreDots.map((cx) => (
            <circle cx={cx} cy="12" r="1.7" />
          ))}
        </svg>
      </summary>
      <nav class="absolute right-0 bottom-full z-10 mb-2 flex flex-col gap-1 rounded-box border border-base-300 bg-base-100 p-1 shadow-lg">
        {more.map((link) => (
          <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            class="icon-link text-base-content/55"
            {...externalAttrs(link.href)}
          >
            <LinkIcon link={link} size={17} />
          </a>
        ))}
      </nav>
    </details>
  )}
</nav>

<div class="fab group/fab absolute! lg:hidden">
  <div
    tabindex="0"
    role="button"
    class="btn btn-lg btn-circle btn-primary shadow-lg group-focus-within/fab:rotate-0! group-focus-within/fab:opacity-100!"
    aria-label={label}
    title={label}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 16 16"
      width="20"
      height="20"
      fill="currentColor"
      aria-hidden="true"
    >
      {linkGlyph.map((path) => (
        <path d={path} />
      ))}
    </svg>
  </div>
  {visible.map((link) => (
    <a
      href={link.href}
      aria-label={link.label}
      title={link.label}
      class="btn btn-lg btn-circle bg-base-100 shadow-md"
      {...externalAttrs(link.href)}
    >
      <LinkIcon link={link} size={20} />
    </a>
  ))}
  {more.length > 0 && (
    <div class="relative">
      <div class="fab static!">
        <div
          tabindex="0"
          role="button"
          class="btn btn-lg btn-circle bg-base-100 shadow-md"
          aria-label={moreLabel}
          title={moreLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            {moreDots.map((cx) => (
              <circle cx={cx} cy="12" r="1.7" />
            ))}
          </svg>
        </div>
        {more.map((link, index) => (
          <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            class={`btn btn-lg btn-circle bg-base-100 shadow-md${index === 0 ? " fab-main-action" : ""}`}
            {...externalAttrs(link.href)}
          >
            <LinkIcon link={link} size={20} />
          </a>
        ))}
      </div>
    </div>
  )}
</div>

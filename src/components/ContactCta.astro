---
import { getLocale } from "virtual:astro-localized-routes"
import ContactModal from "./ContactModal.astro"
import ContactTrigger from "./ContactTrigger.astro"
import { useTranslations } from "../i18n/ui"
import { contactFor } from "../lib/content"

const lang = getLocale(Astro)
const t = useTranslations(lang)
const contact = (await contactFor(lang)).data
---

<section class="border-t border-primary/25">
  <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="relative overflow-hidden rounded-box border border-primary/20 bg-primary/5 p-6 sm:p-10">
      <div class="brand-rule absolute inset-x-0 top-0" aria-hidden="true"></div>
      <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="eyebrow">{t("nav.contact")}</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">
            {contact.title}
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-base-content/65">{contact.body}</p>
        </div>
        <ContactTrigger label={contact.cta} />
      </div>
    </div>
  </div>
</section>

<ContactModal lang={lang} trigger={false} />

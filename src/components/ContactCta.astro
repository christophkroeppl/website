---
import { contact } from "../content/site"
import { pick } from "../content/types"
import { getLocale } from "virtual:astro-localized-routes"
import { pathFor } from "../i18n/routes"
import { useTranslations } from "../i18n/ui"

const lang = getLocale(Astro)
const t = useTranslations(lang)
---

<section class="border-t border-base-300/60">
  <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="grid gap-6 rounded-box border border-base-300/70 bg-base-200/40 p-6 sm:p-10 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="eyebrow">{t("nav.contact")}</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">
          {pick(lang, contact.title)}
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-base-content/60">
          {pick(lang, contact.body)}
        </p>
      </div>
      <a class="btn btn-primary btn-sm sm:btn-md" href={pathFor("contact", lang)}>
        {pick(lang, contact.cta)}
      </a>
    </div>
  </div>
</section>

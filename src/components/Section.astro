---
interface Props {
  id?: string
  eyebrow?: string
  title: string
  intro?: string
  tone?: "default" | "muted" | "primary" | "secondary" | "accent"
}

const { id, eyebrow, title, intro, tone = "default" } = Astro.props
const hasAction = Astro.slots.has("action")

const tones = {
  default: "",
  muted: "bg-base-200/60",
  primary: "bg-primary/5",
  secondary: "bg-secondary/5",
  accent: "bg-accent/5",
}
---

<section id={id} class:list={["border-t border-primary/25 py-14 sm:py-20", tones[tone]]}>
  <div class="mx-auto grid w-full max-w-5xl gap-y-8 px-4 sm:grid-cols-[1fr_auto] sm:items-end sm:gap-y-10 sm:px-6">
    <div class="sm:col-start-1 sm:row-start-1">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="mt-2 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">{title}</h2>
      {intro && <p class="mt-3 max-w-xl text-sm leading-relaxed text-base-content/55">{intro}</p>}
    </div>
    <div class="sm:col-span-2 sm:row-start-2">
      <slot />
    </div>
    {hasAction && (
      <div class="flex justify-center sm:col-start-2 sm:row-start-1 sm:block sm:self-end">
        <slot name="action" />
      </div>
    )}
  </div>
</section>

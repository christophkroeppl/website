---
interface Props {
  id?: string
  eyebrow?: string
  title: string
  intro?: string
  tone?: "default" | "muted"
}

const { id, eyebrow, title, intro, tone = "default" } = Astro.props
---

<section
  id={id}
  class:list={["border-t border-base-300/60 py-14 sm:py-20", tone === "muted" && "bg-base-200/40"]}
>
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
    <div class="mb-8 grid gap-4 sm:mb-10 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">{title}</h2>
        {intro && <p class="mt-3 max-w-xl text-sm leading-relaxed text-base-content/55">{intro}</p>}
      </div>
      <slot name="action" />
    </div>
    <slot />
  </div>
</section>

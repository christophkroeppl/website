---
import { externalAttrs } from "../links/external"
import type { Link } from "../links/types"
import LinkIcon from "./LinkIcon.astro"

interface Props {
  link: Link
}

const { link } = Astro.props
const external = externalAttrs(link.href)
---

<a
  href={link.href}
  class="btn btn-outline btn-lg btn-block justify-start gap-3 font-normal hover:border-accent hover:bg-accent/5 hover:text-accent"
  {...external}
>
  <LinkIcon link={link} size={20} />
  <span class="truncate">{link.label}</span>
</a>

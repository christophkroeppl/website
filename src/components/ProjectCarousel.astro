---
import ProjectCard from "./ProjectCard.astro"
import ProjectSlide from "./ProjectSlide.astro"
import type { ProjectData } from "../content.config"
import type { Locale } from "../i18n/locales"
import { projectPosition, splitProjects } from "../lib/projects"

interface Props {
  projects: { data: ProjectData }[]
  lang: Locale
  basePath: string
  label: string
}

const { projects, lang, basePath, label } = Astro.props
const { featured } = splitProjects(projects)
---

<div class="relative -mx-4 min-w-0 sm:hidden">
  <div
    class="overflow-hidden"
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    data-carousel-viewport
  >
    <div class="flex touch-pan-y" data-carousel-container>
      {projects.map((project, index) => (
        <ProjectSlide
          project={project.data}
          lang={lang}
          index={projectPosition(0, index)}
          href={`${basePath}#${project.data.id}`}
        />
      ))}
    </div>
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-linear-to-r from-base-100 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-linear-to-l from-base-100 to-transparent"
    aria-hidden="true"
  ></div>
</div>

<div class="hidden gap-x-10 gap-y-10 sm:grid sm:grid-cols-2 lg:grid-cols-3">
  {featured.map((project, index) => (
    <ProjectCard
      project={project.data}
      lang={lang}
      index={projectPosition(0, index)}
      href={`${basePath}#${project.data.id}`}
    />
  ))}
</div>

<script>
  const mobile = window.matchMedia("(max-width: 639px)")
  const viewport = document.querySelector<HTMLElement>("[data-carousel-viewport]")
  let carousel: import("embla-carousel").EmblaCarouselType | undefined
  let observer: IntersectionObserver | undefined

  const start = async () => {
    if (!mobile.matches || !viewport || carousel) return
    const { default: EmblaCarousel } = await import("embla-carousel")
    if (!mobile.matches || !viewport || carousel) return
    carousel = EmblaCarousel(viewport, {
      align: "center",
      containScroll: false,
      loop: true,
    })
  }

  const watch = () => {
    if (!mobile.matches || !viewport || carousel || observer) return
    observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer?.disconnect()
        observer = undefined
        void start()
      },
      { threshold: 0.01 },
    )
    observer.observe(viewport)
  }

  const stop = () => {
    observer?.disconnect()
    observer = undefined
    carousel?.destroy()
    carousel = undefined
  }

  const sync = () => (mobile.matches ? watch() : stop())

  const schedule = () => {
    const idle =
      window.requestIdleCallback ??
      ((callback: IdleRequestCallback) =>
        window.setTimeout(() => callback({ didTimeout: false, timeRemaining: () => 0 }), 0))
    idle(() => sync())
  }

  if (document.readyState === "complete") schedule()
  else window.addEventListener("load", schedule, { once: true })

  mobile.addEventListener("change", sync)
</script>

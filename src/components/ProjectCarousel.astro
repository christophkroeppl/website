---
import ProjectCard from "./ProjectCard.astro"
import ProjectSlide from "./ProjectSlide.astro"
import type { ProjectData } from "../content.config"
import { localeMeta, type Locale } from "../i18n/locales"
import { splitProjects, projectPosition } from "../lib/projects"

interface Props {
  projects: { data: ProjectData }[]
  lang: Locale
  basePath: string
  label: string
}

const { projects, lang, basePath, label } = Astro.props
const { featured } = splitProjects(projects)
---

<div
  class="relative -mx-4 min-w-0 sm:hidden"
  data-carousel-lazy
  data-carousel-lazy-url={`${localeMeta[lang].prefix}/api/project-slides/`}
>
  <div
    class="overflow-hidden"
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    data-carousel-viewport
  >
    <div class="flex touch-pan-y" data-carousel-container>
      {featured.map((project, index) => (
        <ProjectSlide
          project={project.data}
          lang={lang}
          index={projectPosition(0, index)}
          href={`${basePath}#${project.data.id}`}
        />
      ))}
    </div>
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-linear-to-r from-base-100 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-linear-to-l from-base-100 to-transparent"
    aria-hidden="true"
  ></div>
</div>

<div class="hidden gap-x-10 gap-y-10 sm:grid sm:grid-cols-2 lg:grid-cols-3">
  {featured.map((project, index) => (
    <ProjectCard
      project={project.data}
      lang={lang}
      index={projectPosition(0, index)}
      href={`${basePath}#${project.data.id}`}
    />
  ))}
</div>

<script>
  const mobile = window.matchMedia("(max-width: 639px)")
  const lazy = document.querySelector<HTMLElement>("[data-carousel-lazy]")
  const viewport = document.querySelector<HTMLElement>("[data-carousel-viewport]")
  const container = viewport?.querySelector<HTMLElement>("[data-carousel-container]")
  let carousel: import("embla-carousel").EmblaCarouselType | undefined
  let observer: IntersectionObserver | undefined
  let loading = false
  let loaded = false

  const loadMore = async () => {
    const url = lazy?.dataset.carouselLazyUrl
    if (loading || loaded || !url || !container) return
    loading = true
    try {
      const response = await fetch(url, { signal: AbortSignal.timeout(10000) })
      if (!response.ok) return
      const template = document.createElement("template")
      template.innerHTML = await response.text()
      container.append(...template.content.querySelectorAll("[data-carousel-slide]"))
      loaded = true
      carousel?.reInit()
    } finally {
      loading = false
    }
  }

  const observe = () => {
    if (!mobile.matches || loaded || observer || !lazy) return
    observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return
      observer?.disconnect()
      observer = undefined
      void loadMore()
    })
    observer.observe(lazy)
  }

  const sync = async () => {
    if (mobile.matches && viewport && !carousel) {
      const { default: EmblaCarousel } = await import("embla-carousel")
      if (mobile.matches && viewport && !carousel) {
        carousel = EmblaCarousel(viewport, {
          align: "center",
          containScroll: false,
          loop: true,
        })
      }
      observe()
    } else if (!mobile.matches) {
      observer?.disconnect()
      observer = undefined
      if (carousel) {
        carousel.destroy()
        carousel = undefined
      }
    }
  }

  sync()
  mobile.addEventListener("change", sync)
</script>

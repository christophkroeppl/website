---
import { revealOutlines } from "../generated/reveals"
import { type Locale } from "../i18n/locales"
import { type RevealId } from "../reveals/registry"

interface Props {
  id: RevealId
  lang: Locale
}

const { id, lang } = Astro.props
const { viewBox, labels } = revealOutlines[id]
const label = labels[lang]
const labelWidth = (label.width / viewBox.units).toFixed(2)
---

<div data-reveal data-reveal-id={id} data-reveal-lang={lang}>
  <button type="button" data-reveal-button class="btn btn-outline mt-3">
    <svg
      viewBox={`0 ${viewBox.top} ${label.width} ${viewBox.height}`}
      style={`width:${labelWidth}em`}
      fill="currentColor"
      class="h-auto max-w-full"
    >
      <path d={label.d}></path>
    </svg>
  </button>
  <div data-reveal-lines class="grid gap-[0.4em]" hidden></div>
</div>

<script>
  type Outline = { d: string; width: number }
  type Payload = { viewBox: { top: number; height: number; units: number }; lines: Outline[] }

  const namespace = "http://www.w3.org/2000/svg"

  function fit(target: HTMLElement, payload: Payload) {
    const widest = Math.max(...payload.lines.map((line) => line.width)) / payload.viewBox.units
    target.style.fontSize = ""
    const base = Number.parseFloat(getComputedStyle(target).fontSize)
    if (!Number.isFinite(base) || widest <= 0) return
    const needed = widest * base
    if (needed > target.clientWidth) {
      target.style.fontSize = `${(base * target.clientWidth) / needed}px`
    }
  }

  function render(target: HTMLElement, payload: Payload) {
    const { top, height, units } = payload.viewBox
    target.replaceChildren(
      ...payload.lines.map((line) => {
        const svg = document.createElementNS(namespace, "svg")
        svg.setAttribute("viewBox", `0 ${top} ${line.width} ${height}`)
        svg.setAttribute("fill", "currentColor")
        svg.setAttribute("style", `width:${(line.width / units).toFixed(2)}em`)
        const path = document.createElementNS(namespace, "path")
        path.setAttribute("d", line.d)
        svg.appendChild(path)
        return svg
      }),
    )
    target.hidden = false
    fit(target, payload)
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
    const id = root.dataset.revealId
    const lang = root.dataset.revealLang
    const button = root.querySelector<HTMLButtonElement>("[data-reveal-button]")
    const target = root.querySelector<HTMLElement>("[data-reveal-lines]")
    if (!id || !lang || !button || !target) continue

    let loaded: Promise<Payload> | undefined

    const request = () => {
      loaded ??= fetch(`/api/reveals/${encodeURIComponent(id)}/?lang=${encodeURIComponent(lang)}`, {
        headers: { Accept: "application/json" },
      })
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status))
          return response.json() as Promise<Payload>
        })
        .catch((reason: unknown) => {
          loaded = undefined
          throw reason
        })
      return loaded
    }

    const prefetch = () => {
      request().catch(() => {})
    }

    const reveal = () => {
      button.disabled = true
      request()
        .then((payload) => {
          render(target, payload)
          button.hidden = true
          let width = Math.round(target.clientWidth)
          new ResizeObserver(([entry]) => {
            const next = Math.round(entry.contentRect.width)
            if (next === width) return
            width = next
            fit(target, payload)
          }).observe(target)
        })
        .catch(() => {
          button.disabled = false
        })
    }

    button.addEventListener("pointerenter", prefetch, { once: true })
    button.addEventListener("focus", prefetch, { once: true })
    button.addEventListener("click", reveal)
  }
</script>

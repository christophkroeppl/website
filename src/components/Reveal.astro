---
import { type Locale } from "../i18n/locales"
import { type RevealId } from "../reveals/registry"

interface Props {
  id: RevealId
  lang: Locale
}

const { id, lang } = Astro.props
---

<div data-reveal data-reveal-id={id} data-reveal-lang={lang}>
  <button type="button" data-reveal-button class="btn btn-outline mt-3"></button>
  <div data-reveal-lines class="grid gap-[0.4em]" hidden></div>
</div>

<script>
  type Outline = { d: string; width: number }
  type ViewBox = { top: number; height: number; units: number }
  type Payload = { viewBox: ViewBox; lines: Outline[] }
  type LabelPayload = { viewBox: ViewBox; label: Outline }

  const namespace = "http://www.w3.org/2000/svg"

  async function get<T>(id: string, lang: string, part?: string): Promise<T> {
    const search = new URLSearchParams({ lang })
    if (part) search.set("part", part)
    const response = await fetch(`/api/reveals/${encodeURIComponent(id)}/?${search}`, {
      headers: { Accept: "application/json" },
    })
    if (!response.ok) throw new Error(String(response.status))
    return response.json() as Promise<T>
  }

  function fit(target: HTMLElement, payload: Payload) {
    const widest = Math.max(...payload.lines.map((line) => line.width)) / payload.viewBox.units
    target.style.fontSize = ""
    const base = Number.parseFloat(getComputedStyle(target).fontSize)
    if (!Number.isFinite(base) || widest <= 0) return
    const needed = widest * base
    if (needed > target.clientWidth) {
      target.style.fontSize = `${(base * target.clientWidth) / needed}px`
    }
  }

  function render(target: HTMLElement, payload: Payload) {
    const { top, height, units } = payload.viewBox
    target.replaceChildren(
      ...payload.lines.map((line) => {
        const element = document.createElementNS(namespace, "svg")
        element.setAttribute("viewBox", `0 ${top} ${line.width} ${height}`)
        element.setAttribute("fill", "currentColor")
        element.setAttribute("style", `width:${(line.width / units).toFixed(2)}em`)
        const path = document.createElementNS(namespace, "path")
        path.setAttribute("d", line.d)
        element.appendChild(path)
        return element
      }),
    )
    target.hidden = false
    fit(target, payload)
  }

  function svg(label: Outline, viewBox: ViewBox) {
    const element = document.createElementNS(namespace, "svg")
    element.setAttribute("viewBox", `0 ${viewBox.top} ${label.width} ${viewBox.height}`)
    element.setAttribute("fill", "currentColor")
    element.setAttribute("style", `width:${(label.width / viewBox.units).toFixed(2)}em`)
    element.setAttribute("class", "h-auto max-w-full")
    const path = document.createElementNS(namespace, "path")
    path.setAttribute("d", label.d)
    element.appendChild(path)
    return element
  }

  window.addEventListener("load", () => {
    const idle =
      window.requestIdleCallback ??
      ((callback: IdleRequestCallback) =>
        window.setTimeout(() => callback({ didTimeout: false, timeRemaining: () => 0 }), 0))
    idle(() => {
      for (const root of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
        const id = root.dataset.revealId
        const lang = root.dataset.revealLang
        const button = root.querySelector<HTMLButtonElement>("[data-reveal-button]")
        if (!id || !lang || !button) continue
        get<LabelPayload>(id, lang, "label")
          .then(({ viewBox, label }) => button.appendChild(svg(label, viewBox)))
          .catch(() => {})
      }
    })
  })

  for (const root of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
    const id = root.dataset.revealId
    const lang = root.dataset.revealLang
    const button = root.querySelector<HTMLButtonElement>("[data-reveal-button]")
    const target = root.querySelector<HTMLElement>("[data-reveal-lines]")
    if (!id || !lang || !button || !target) continue

    button.addEventListener("click", () => {
      button.disabled = true
      get<Payload>(id, lang)
        .then((payload) => {
          render(target, payload)
          button.hidden = true
          let width = Math.round(target.clientWidth)
          new ResizeObserver((entries) => {
            const entry = entries[0]
            if (!entry) return
            const next = Math.round(entry.contentRect.width)
            if (next === width) return
            width = next
            fit(target, payload)
          }).observe(target)
        })
        .catch(() => {
          button.disabled = false
        })
    })
  }
</script>

---
import ImageCompare from "./ImageCompare.astro"
import LazyIframe from "./LazyIframe.astro"
import type { ProjectData } from "../content.config"

interface Props {
  project: ProjectData
  index: number
}

const { project, index } = Astro.props
---

<article
  id={project.id}
  class="scroll-mt-24 border-t border-base-300/70 py-14 first:border-t-0 first:pt-0"
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem]">
    <div>
      <div class="flex items-baseline gap-4">
        <span class="font-mono text-xs text-base-content/40">{String(index).padStart(2, "0")}</span>
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/45">
          {project.status}
        </span>
      </div>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">{project.name}</h2>
      <p class="mt-2 text-lg text-base-content/60">{project.tagline}</p>

      <div class="mt-6 space-y-4 text-base leading-relaxed text-base-content/75">
        <slot />
      </div>

      <ul class="mt-6 grid gap-2 text-sm leading-relaxed text-base-content/70">
        {project.highlights.map((highlight) => (
          <li class="flex gap-3">
            <span
              aria-hidden="true"
              class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-secondary"
            />
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="space-y-6 text-sm">
      <dl class="space-y-6">
        <div>
          <dt class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/45">
            Stack
          </dt>
          <dd class="mt-2 text-base-content/70">{project.stack.join(" · ")}</dd>
        </div>
        <div>
          <dt class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/45">
            Status
          </dt>
          <dd class="mt-2 text-base-content/70">{project.status}</dd>
        </div>
        <div>
          <dt class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/45">
            Links
          </dt>
          <dd class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
            {project.links.map((link) => (
              <a class="link-quiet" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label} ↗
              </a>
            ))}
          </dd>
        </div>
      </dl>
    </aside>
  </div>

  <div class="mt-10">
    {project.artifact.kind === "html" ? (
      <LazyIframe
        src={project.artifact.src}
        title={project.artifact.title}
        aspect={project.artifact.aspect}
        class="max-sm:-mx-4 max-sm:rounded-none max-sm:border-x-0"
      />
    ) : (
      <ImageCompare
        before={project.artifact.before}
        after={project.artifact.after}
        beforeLabel={project.artifact.beforeLabel}
        afterLabel={project.artifact.afterLabel}
        caption={project.artifact.caption}
        aspect={project.artifact.aspect}
        orientation={project.artifact.orientation}
      />
    )}
  </div>
</article>

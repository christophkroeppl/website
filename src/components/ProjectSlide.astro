---
import ProjectCard from "./ProjectCard.astro"
import type { ProjectData } from "../content.config"
import type { Locale } from "../i18n/locales"

interface Props {
  project: ProjectData
  lang: Locale
  index: number
  href: string
}

const { project, lang, index, href } = Astro.props
---

<div
  class="min-w-0 flex-[0_0_84%] snap-center snap-always px-2"
  role="group"
  aria-roledescription="slide"
>
  <ProjectCard project={project} lang={lang} index={index} href={href} />
</div>

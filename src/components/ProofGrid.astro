---
interface Props {
  items: { value: string; label: string }[]
}

const { items } = Astro.props
---

<dl class="grid grid-cols-2 gap-x-6 gap-y-8 border-t border-primary/25 pt-8 sm:grid-cols-4">
  {items.map((item) => (
    <div>
      <dt class="sr-only">{item.label}</dt>
      <dd>
        <span class="block font-mono text-3xl font-medium tracking-tight text-primary sm:text-4xl">
          {item.value}
        </span>
        <span class="mt-2 block text-xs leading-relaxed text-base-content/65">{item.label}</span>
      </dd>
    </div>
  ))}
</dl>

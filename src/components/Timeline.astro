---
import { pick } from "../content/types"
import type { Role } from "../content/experience"
import type { Locale } from "../i18n/locales"

interface Props {
  roles: Role[]
  lang: Locale
  compact?: boolean
}

const { roles, lang, compact = false } = Astro.props
---

<ol class="space-y-8">
  {roles.map((role) => (
    <li class="grid gap-2 border-t border-base-300/60 pt-6 first:border-t-0 first:pt-0 sm:grid-cols-[8.5rem_1fr] sm:gap-8">
      <div class="font-mono text-xs leading-relaxed text-base-content/45">{role.period}</div>
      <div>
        <h3 class="text-base font-semibold tracking-[-0.01em]">{pick(lang, role.title)}</h3>
        <p class="mt-0.5 text-sm text-base-content/55">
          {role.org} · {pick(lang, role.location)}
        </p>
        {role.orgNote && (
          <p class="mt-0.5 text-xs text-base-content/40">{pick(lang, role.orgNote)}</p>
        )}
        <p class="mt-3 text-sm leading-relaxed text-base-content/70">{pick(lang, role.summary)}</p>
        {!compact && (
          <ul class="mt-3 list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-base-content/65">
            {role.bullets.map((bullet) => (
              <li>{pick(lang, bullet)}</li>
            ))}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>

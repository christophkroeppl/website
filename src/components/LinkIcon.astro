---
import type { Link } from "../links/types"

interface Props {
  link: Link
  size?: number
}

const { link, size = 20 } = Astro.props
const icon = link.icon
---

{icon.kind === "svg" ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={icon.viewBox}
    width={size}
    height={size}
    fill="currentColor"
    class="shrink-0"
    aria-hidden="true"
  >
    {icon.paths.map((path) => (
      <path d={path} fill-rule={icon.fillRule} />
    ))}
  </svg>
) : (
  <img src={icon.src} alt="" width={size} height={size} class="shrink-0 object-contain" />
)}

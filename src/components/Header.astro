---
import { Image } from "astro:assets"
import bullet from "../assets/bullet.webp"
import { getLocale } from "virtual:astro-localized-routes"
import { pathFor } from "../i18n/routes"
import { person } from "../content/site"
import LanguageSwitcher from "./LanguageSwitcher.astro"

const lang = getLocale(Astro)
---

<header class="sticky top-0 z-40 border-b border-primary/25 bg-base-100/85 backdrop-blur">
  <div class="brand-rule" aria-hidden="true"></div>
  <div class="mx-auto flex w-full max-w-5xl items-center gap-3 px-4 py-3 sm:px-6">
    <a
      href={pathFor("home", lang)}
      class="group flex min-w-0 items-center gap-3"
      aria-label={person.name}
    >
      <Image
        src={bullet}
        alt=""
        width={72}
        height={72}
        class="h-9 w-9 shrink-0 rounded-full object-cover ring-2 ring-primary/20 ring-offset-1 ring-offset-base-100 transition-shadow group-hover:ring-primary/45"
      />
      <span class="truncate text-sm font-semibold tracking-tight transition-colors group-hover:text-primary">
        {person.name}
      </span>
    </a>

    <div class="ml-auto flex items-center gap-1">
      <LanguageSwitcher />
    </div>
  </div>
</header>

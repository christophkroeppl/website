---
interface Props {
  src: string
  title: string
  aspect: string
  class?: string
}

const { src, title, aspect, class: className } = Astro.props

const hashIndex = src.indexOf("#")
const srcBase = hashIndex === -1 ? src : src.slice(0, hashIndex)
const srcHash = hashIndex === -1 ? "" : src.slice(hashIndex)
const embedSrc = `${srcBase}${srcBase.includes("?") ? "&" : "?"}embed=1${srcHash}`
---

<div
  class:list={[
    "relative rounded-box border border-base-300/70 bg-base-200/40 shadow-sm",
    className,
  ]}
  style={`--frame-aspect:${aspect}`}
  data-iframe-frame
>
  <iframe
    data-src={embedSrc}
    title={title}
    class="absolute inset-0 h-full w-full"
    loading="lazy"
    sandbox="allow-scripts"
  ></iframe>
  <noscript>
    <a
      href={src}
      class="absolute inset-0 grid place-items-center bg-base-200/40 text-sm font-medium text-base-content/70 underline underline-offset-4"
    >
      {title}
    </a>
  </noscript>
</div>

<style>
  [data-iframe-frame] {
    aspect-ratio: var(--frame-aspect);
    overflow: hidden;
  }

  @media (max-width: 639px) {
    [data-iframe-frame] {
      aspect-ratio: 4 / 5;
    }
  }
</style>

<script>
  const load = (frame: HTMLIFrameElement) => {
    const src = frame.dataset.src
    if (!src) return
    frame.src = src
    delete frame.dataset.src
  }

  const lazyFrames = [...document.querySelectorAll<HTMLIFrameElement>("iframe[data-src]")]

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          load(entry.target as HTMLIFrameElement)
          observer.unobserve(entry.target)
        }
      },
      { rootMargin: "600px 0px" },
    )

    for (const frame of lazyFrames) observer.observe(frame)
  } else {
    for (const frame of lazyFrames) load(frame)
  }
</script>

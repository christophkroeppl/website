---
import { getLocale } from "virtual:astro-localized-routes"
import { useTranslations } from "../i18n/ui"

interface Props {
  before: string
  after: string
  beforeLabel: string
  afterLabel: string
  caption: string
  aspect?: string
  orientation?: "horizontal" | "vertical"
}

const {
  before,
  after,
  beforeLabel,
  afterLabel,
  caption,
  aspect = "16/10",
  orientation = "horizontal",
} = Astro.props

const t = useTranslations(getLocale(Astro))
const interpolate = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "")

const vertical = orientation === "vertical"
---

<figure>
  <div
    class:list={[
      "compare relative overflow-hidden rounded-box border border-base-300/70 bg-base-100 shadow-sm",
      vertical && "compare-vertical",
    ]}
    style={`aspect-ratio:${aspect}`}
    data-compare
    data-orientation={orientation}
  >
    <img
      src={before}
      alt={interpolate(t("projects.compare.alt"), { label: beforeLabel })}
      width={1600}
      height={1000}
      class="absolute inset-0 size-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <img
      src={after}
      alt={interpolate(t("projects.compare.alt"), { label: afterLabel })}
      width={1600}
      height={1000}
      class="compare-after absolute inset-0 size-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <span class="absolute rounded-full bg-base-100/90 px-2 py-1 text-xs font-medium text-base-content/70 shadow-sm left-3 top-3">
      {beforeLabel}
    </span>
    <span
      class:list={[
        "absolute rounded-full bg-base-100/90 px-2 py-1 text-xs font-medium text-base-content/70 shadow-sm",
        vertical ? "bottom-3 left-3" : "right-3 top-3",
      ]}
    >
      {afterLabel}
    </span>

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label={interpolate(t("projects.compare.aria"), {
        before: beforeLabel,
        after: afterLabel,
      })}
      aria-orientation={orientation}
      class:list={[
        "absolute inset-0 z-20 h-full w-full",
        vertical ? "sr-only" : "cursor-ew-resize opacity-0",
      ]}
      data-compare-range
    />
    {vertical && (
      <div class="absolute inset-0 z-20 cursor-ns-resize touch-none" data-compare-surface></div>
    )}
    <span class="compare-divider" data-compare-divider aria-hidden="true">
      <span class="absolute left-1/2 top-1/2 grid size-8 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-base-100 text-sm text-base-content shadow">
        {vertical ? "↕" : "↔"}
      </span>
    </span>
  </div>
  <figcaption class="mt-3 text-xs text-base-content/65">{caption}</figcaption>
</figure>

<style>
  .compare-after {
    clip-path: inset(0 0 0 var(--compare, 50%));
  }

  .compare-vertical .compare-after {
    clip-path: inset(var(--compare, 50%) 0 0 0);
  }

  .compare-divider {
    position: absolute;
    z-index: 10;
    left: var(--compare, 50%);
    top: 0;
    bottom: 0;
    width: 0.125rem;
    background: var(--color-base-100);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
    transform: translateX(-50%);
  }

  .compare-vertical .compare-divider {
    left: 0;
    right: 0;
    top: var(--compare, 50%);
    bottom: auto;
    width: auto;
    height: 0.125rem;
    transform: translateY(-50%);
  }

  .compare:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max)

  for (const root of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const range = root.querySelector<HTMLInputElement>("[data-compare-range]")
    if (!range) continue

    const vertical = root.dataset.orientation === "vertical"
    const update = () => root.style.setProperty("--compare", `${range.value}%`)

    const setFromPointer = (event: PointerEvent) => {
      const rect = root.getBoundingClientRect()
      const ratio = vertical
        ? (event.clientY - rect.top) / rect.height
        : (event.clientX - rect.left) / rect.width
      range.value = String(Math.round(clamp(ratio * 100, 0, 100)))
      update()
    }

    const surface = root.querySelector<HTMLElement>("[data-compare-surface]")
    surface?.addEventListener("pointerdown", (event) => {
      surface.setPointerCapture(event.pointerId)
      setFromPointer(event)
    })
    surface?.addEventListener("pointermove", (event) => {
      if (event.buttons) setFromPointer(event)
    })

    range.addEventListener("input", update)
    range.addEventListener("keydown", (event) => {
      if (!vertical) return
      const delta = event.key === "ArrowUp" ? 5 : event.key === "ArrowDown" ? -5 : 0
      if (!delta) return
      event.preventDefault()
      range.value = String(clamp(Number(range.value) + delta, 0, 100))
      update()
    })

    update()
  }
</script>

# Schema for Astro/Vite build-time env vars.
# Cloudflare Worker runtime secrets are declared in `.dev.vars.schema` instead.
#
# @defaultRequired=infer
# @defaultSensitive=inferFromPrefix(PUBLIC_)
# ---

# Cloudflare Turnstile site key rendered by the contact form widget
PUBLIC_TURNSTILE_SITE_KEY=

# Display name shown for the site owner on contact and legal pages
PUBLIC_CONTACT_NAME=

# Site owner postal address, comma-separated into display lines
CONTACT_ADDRESS=

# Site owner contact email address
# @type=email
CONTACT_EMAIL=

# Site owner contact phone number
CONTACT_PHONE=

# Linktree icon pack used to resolve <PLATFORM>_LINK slugs.
# Defaults to simple-icons; packs are declared in src/links/icons.ts.
LINKS_ICON_PACK=

# Optional tagline shown under the name on links.kroeppl.ch
LINKS_TAGLINE=

# Linktree links: <PLATFORM>_LINK[_VARIANT]="<absolute url>"
# The platform part is the icon slug (lowercased, underscores become dashes).
# A non-numeric variant is appended to the label; an all-digit variant is not.
# A *_LABEL key overrides the label and *_ICON selects another icon slug.
# @type=url
GITHUB_LINK=
# @type=url
LINKEDIN_LINK=
# @type=url
INSTAGRAM_LINK=
# @type=url
FACEBOOK_LINK=
# @type=url
X_LINK=
# @type=url
FREE_CITIES_FOUNDATION_LINK=
# @type=url
BITCOIN_LINK_WHITEPAPER=
# @type=url
BITCR_LINK_HOME=
BITCR_LINK_HOME_LABEL=
# @type=url
BITCR_LINK_USE_CASES=
BITCR_LINK_USE_CASES_LABEL=
BITCR_LINK_USE_CASES_ICON=
# @type=url
WEBSITE_LINK=

# Schema for Astro/Vite build-time env vars.
# Cloudflare Worker runtime secrets are declared in `.dev.vars.schema` instead.
#
# @defaultRequired=infer
# @defaultSensitive=inferFromPrefix(PUBLIC_)
# ---

# Cloudflare Turnstile site key rendered by the contact form widget
PUBLIC_TURNSTILE_SITE_KEY=

# Display name shown for the site owner on contact and legal pages
PUBLIC_CONTACT_NAME=

# Site owner postal address, comma-separated into display lines
CONTACT_ADDRESS=

# Site owner contact email address
# @type=email
CONTACT_EMAIL=

# Site owner contact phone number
CONTACT_PHONE=

# Linktree links: LINK_<NN>_<PLATFORM>="<absolute url>"
# NN is a two-digit order index and must be unique across link keys.
# The platform part becomes the link slug (lowercased, underscores become dashes).
# A *_LABEL key overrides the label and *_ICON selects another icon slug.
# @type=url
LINK_01_LINKEDIN=
# @type=url
LINK_02_INSTAGRAM=
# @type=url
LINK_03_FACEBOOK=
# @type=url
LINK_04_X=
# @type=url
LINK_05_GITHUB=
# @type=url
LINK_06_WEBSITE=
# @type=url
LINK_07_URL1=
LINK_07_URL1_LABEL=
LINK_07_URL1_ICON=
# Add as many more Links as you like!
# @type=url
LINK_NN_URLN=
LINK_NN_URLN_LABEL=
LINK_NN_URLN_ICON=
